# PayTeam backend environment template. Copy to .env and set PayTeam-only values.
# Provision a separate payteam_* database and Redis service/namespace first.

# Application
# APP_ENV overrides NODE_ENV; if both are absent the code uses development.
APP_NAME=PayTeam
APP_ENV=development
APP_PORT=3000
ADMIN_CATALOGUE_ENABLED=false

# Database: never reuse AquaPay database credentials or database names.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=payteam_dev
DB_USER=replace_with_payteam_database_user
DB_PASSWORD=replace_with_payteam_database_password
DB_SSL_CA=

# Redis: development defaults are loopback, port 6379, and payteam:development.
# Tests and production require an explicit host and PayTeam prefix.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=payteam:development
REDIS_RESP_VERSION=2

# JWT and authentication
JWT_SECRET=replace_with_unique_payteam_secret_at_least_32_characters
JWT_EXPIRES_IN=1h
AUTH_BCRYPT_SALT_ROUNDS=12
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_RESET_TOKEN_TTL_MINUTES=15
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=60
AUTH_LOGIN_IDENTIFIER_LIMIT=10
AUTH_RECOVERY_WINDOW_SECONDS=3600
AUTH_RECOVERY_IP_LIMIT=30
AUTH_RECOVERY_IDENTIFIER_LIMIT=5
AUTH_RESET_TOKEN_LIMIT=10
AUTH_RECOVERY_BASE_URL=http://localhost:5173
AUTH_RECOVERY_EMAIL_URL=
AUTH_RECOVERY_EMAIL_API_KEY=
AUTH_RECOVERY_SMS_URL=
AUTH_RECOVERY_SMS_API_KEY=

# Optional one-time admin bootstrap protection; set a unique key before using setup routes.
ADMIN_SETUP_KEY=replace_with_unique_payteam_admin_setup_key

# KYC OTP. Expiry is seconds; failed verification attempts are capped per challenge.
KYC_OTP_SECRET=replace_with_unique_payteam_secret_at_least_32_characters
OTP_EXPIRY=300
OTP_MAX_ATTEMPTS=5

# KYC encryption uses separate, versioned keys for identity, provider sessions, and bank accounts.
# Set fresh values for PayTeam; never copy AquaPay encryption keys.
KYC_IDENTITY_ENCRYPTION_ACTIVE_KEY_VERSION=1
KYC_IDENTITY_DEV_ENCRYPTION_KEY_V1=
KYC_IDENTITY_TEST_ENCRYPTION_KEY_V1=
KYC_IDENTITY_PROD_ENCRYPTION_KEY_V1=
KYC_PROVIDER_SESSION_ENCRYPTION_ACTIVE_KEY_VERSION=1
KYC_PROVIDER_SESSION_DEV_ENCRYPTION_KEY_V1=
KYC_PROVIDER_SESSION_TEST_ENCRYPTION_KEY_V1=
KYC_PROVIDER_SESSION_PROD_ENCRYPTION_KEY_V1=
BANK_ACCOUNT_ENCRYPTION_KEY=

# Cloudinary private media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# DigiLocker currently uses IDTO; mock mode is for development/test only.
IDTO_PROVIDER_MODE=mock
IDTO_BASE_URL=https://idto-test.example
IDTO_CLIENT_ID=
IDTO_API_KEY=
IDTO_REDIRECT_URL=http://127.0.0.1:3000/api/kyc/digilocker/callback
IDTO_SKIP_XML_SIGNATURE_VERIFICATION=false
IDTO_DEV_UNVERIFIED_DATABASE=false
IDTO_MOCK_BASE_URL=http://127.0.0.1:3000
IDTO_MOCK_SIGNING_CERT_PATH=src/modules/kyc/document-verification/digilocker/fixtures/mock-signing-cert.crt
IDTO_PAN_XML_TRUSTED_CERT_PATH=

# Customer and admin currently use one Vite application origin. Add approved HTTPS origins comma-separated.
CORS_ORIGINS=http://localhost:5173
